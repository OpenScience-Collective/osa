# ============================================================================
# Open Science Assistant (OSA) - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================================
# LLM Provider: Claude Platform on AWS
# ============================================================================
# OSA runs on the Claude Platform on AWS by default: an Anthropic-operated
# Messages API billed through AWS Marketplace, NOT Amazon Bedrock. OpenRouter
# (see below) remains a supported BYOK-only alternative; it is never the
# platform default.

# Long-lived key from AWS Console -> Claude Platform. Required for
# server-mode requests.
ANTHROPIC_API_KEY=

# The AWS-hosted Messages API endpoint. Optional on its own, but if set,
# ANTHROPIC_WORKSPACE_ID must also be set: the AWS endpoint requires the
# anthropic-workspace-id header. Omitting both falls back to the first-party
# client default (api.anthropic.com).
ANTHROPIC_BASE_URL=

# Workspace the key above is authorized on (format "wrkspc_...").
ANTHROPIC_WORKSPACE_ID=

# Default extended-thinking token budget for budget-style models
# (e.g. claude-haiku-4-5). claude-sonnet-5 uses adaptive thinking instead
# and ignores this.
ANTHROPIC_THINKING_BUDGET_TOKENS=2048

# Default max_tokens for Anthropic Claude Platform requests.
ANTHROPIC_MAX_OUTPUT_TOKENS=8000

# Default prompt-cache lifetime for Anthropic requests: "5m" or "1h".
ANTHROPIC_CACHE_TTL=5m

# Model selection: must be one of the offered Claude models
# (claude-haiku-4-5 or claude-sonnet-5; see OFFERED_MODELS in
# src/core/services/anthropic_llm.py).
DEFAULT_MODEL=claude-haiku-4-5

# Model used for testing (same offered-model ids as DEFAULT_MODEL).
TEST_MODEL=claude-haiku-4-5

# ============================================================================
# OpenRouter (BYOK-only)
# ============================================================================
# OpenRouter is not the platform default. It is only reached when a caller
# brings their own OpenRouter key (widget setting, CLI, or the
# X-OpenRouter-Key header) or a community sets its own
# openrouter_api_key_env_var in config.yaml. No server-side pipeline reaches
# it: FAQ generation used to, and now runs on the Claude Platform like
# everything else.

# Server-side OpenRouter key. Leave unset. Nothing the platform itself runs
# needs it.
OPENROUTER_API_KEY=

# OpenRouter-BYOK-only provider routing hint (e.g., DeepInfra/FP8). Ignored
# on the Anthropic path.
DEFAULT_MODEL_PROVIDER=DeepInfra/FP8
TEST_MODEL_PROVIDER=DeepInfra/FP8

# Credentials for integration tests (pytest -m llm). Most llm-marked tests
# now exercise the Anthropic path and need ANTHROPIC_API_KEY above; a few
# OpenRouter-specific tests still read this separate testing key.
OPENROUTER_API_KEY_FOR_TESTING=

# OpenAI API key (BYOK only; there is no server-side OpenAI routing).
OPENAI_API_KEY=

# LLM sampling temperature (0.0 - 1.0). Only applies to models that accept
# sampling parameters.
LLM_TEMPERATURE=0.1

# ============================================================================
# API Server Configuration
# ============================================================================

# Server host and port
# Port allocation: HEDit prod=38427, HEDit dev=38428, OSA prod=38528, OSA dev=38529
HOST=0.0.0.0
PORT=38528

# Root path for reverse proxy (e.g., /osa for api.osc.earth/osa/). Used
# directly by Settings on the prod deploy path.
ROOT_PATH=

# Dev root path override (e.g., /osa-dev for api.osc.earth/osa-dev/). Read
# directly by deploy/deploy.sh and deploy/auto-update-dev.sh, not Settings;
# defaults to /osa-dev if unset.
DEV_ROOT_PATH=/osa-dev

# ============================================================================
# API Security Configuration
# ============================================================================

# API keys for server authentication (comma-separated list)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Require API key authentication (disable for local dev only)
REQUIRE_API_AUTH=true

# ============================================================================
# LangFuse Observability
# ============================================================================

# LangFuse configuration for tracing and observability
# Get keys at: https://cloud.langfuse.com or self-host
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# Knowledge Sync Configuration
# ============================================================================

# GitHub API token for issue/PR search and feedback integration
# Scopes needed: public_repo (or repo for private repos)
GITHUB_TOKEN=

# Paper source API keys (optional, for higher rate limits)

# OpenAlex: https://docs.openalex.org/how-to-use-the-api/api-key
OPENALEX_API_KEY=
# Email for OpenAlex polite pool (fallback if no API key)
OPENALEX_EMAIL=

# Semantic Scholar: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# PubMed/NCBI: https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=

# Enable/disable automated knowledge sync (master switch; per-community
# schedules are defined in each community's config.yaml)
SYNC_ENABLED=true

# Data directory for the knowledge database (used in Docker deployments)
# Default: platform-specific user data directory
# DATA_DIR=/app/data

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode (verbose logging, hot reload)
DEBUG=false
